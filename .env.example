# Copy to .env and edit for local development.
NIGHTSHIFT_DATA_DIR=./data
NIGHTSHIFT_HOST=127.0.0.1
# 8791 keeps the editor bridge on 8788 free.
NIGHTSHIFT_PORT=8791
NIGHTSHIFT_LOG_LEVEL=info
NIGHTSHIFT_NOTIFY_TARGETS=discord:home
NIGHTSHIFT_PHOTON_TARGET=

# Headless Claude resume runner settings.
# NIGHTSHIFT_CLAUDE_BIN=claude
# NIGHTSHIFT_CLAUDE_PROJECTS_DIR=~/.claude/projects
# NIGHTSHIFT_CLAUDE_PERMISSION_MODE=acceptEdits
# NIGHTSHIFT_RUN_TIMEOUT_SECONDS=3600
# NIGHTSHIFT_TMUX_BIN=tmux
# NIGHTSHIFT_WORKER_POLL_SECONDS=0.5
#
# Editor mirror (typing replay + optional heartbeats). Leave the bridge on 8788.
# NIGHTSHIFT_HACKABOOM_BIN=hackaboom
# NIGHTSHIFT_HACKABOOM_PLUGIN_DIR=~/hackaboom/plugin
# NIGHTSHIFT_HACKABOOM_PORT=8788
# NIGHTSHIFT_HACKABOOM_PREPARE=true
