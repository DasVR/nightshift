# Copy to .env and edit for local development.
NIGHTSHIFT_DATA_DIR=./data
NIGHTSHIFT_HOST=127.0.0.1
NIGHTSHIFT_PORT=8788
NIGHTSHIFT_LOG_LEVEL=info
NIGHTSHIFT_NOTIFY_TARGETS=discord:home
NIGHTSHIFT_PHOTON_TARGET=

